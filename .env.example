# ============================================
# Application Configuration
# ============================================
APP_NAME=Job Market Intelligence
ENVIRONMENT=development  # development | staging | production
DEBUG=True

# Secret key for production (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# Database Configuration
# ============================================
# PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=job_market_intelligence
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:15432/job_market_intelligence_test

# For production (Render/Neon) use DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:port/database

# Connection Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json  # json | console

# ============================================
# API Configuration
# ============================================
API_V1_PREFIX=/api/v1
API_CORS_ORIGINS=["http://localhost:8501", "http://localhost:8000"]

# ============================================
# Dashboard Configuration
# ============================================
API_BASE_URL=http://localhost:8000
DASHBOARD_CACHE_TTL=300  # Cache timeout in seconds

# ============================================
# Adzuna API Configuration (ETL)
# ============================================
ADZUNA_APP_ID=your_app_id_here
ADZUNA_API_KEY=your_api_key_here
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api/jobs
ADZUNA_DEFAULT_COUNTRIES=gb,us,de,ca,au
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=10

# ============================================
# ETL Configuration
# ============================================
RUN_ETL_ON_STARTUP=False
ETL_BATCH_SIZE=100
ETL_RETENTION_DAYS=90

# ============================================
# Language Detection Configuration
# ============================================
LANGUAGE_DETECTION_ENABLED=True
DEFAULT_LANGUAGE=en

# ============================================
# Translation Configuration
# ============================================
# Provider: google | deepl | azure | mock
TRANSLATION_PROVIDER=google

# DeepL (Production-ready)
DEEPL_API_KEY=your_deepl_api_key_here
DEEPL_BASE_URL=https://api.deepl.com/v2

# Azure Translator (Production-ready)
AZURE_TRANSLATOR_KEY=your_azure_key_here
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=your_azure_region_here

# Google Cloud Translation (Production-ready)
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Translation Timeout
TRANSLATION_TIMEOUT=15  # seconds

# ============================================
# Technology Classification Configuration
# ============================================
TECH_CLASSIFICATION_ENABLED=True
TECH_CLASSIFICATION_CONFIG_PATH=config/tech_classification.yaml

# ============================================
# Monitoring & Observability
# ============================================
HEALTH_CHECK_ENABLED=True
METRICS_ENABLED=True
REQUEST_CORRELATION_ID_ENABLED=True

# ============================================
# Performance
# ============================================
CACHE_ENABLED=True
CACHE_TYPE=memory  # memory | redis
REDIS_URL=redis://localhost:6379/0

# ============================================
# Security
# ============================================
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60  # seconds

# ============================================
# Feature Flags
# ============================================
FEATURE_ENABLE_TRANSLATION=True
FEATURE_ENABLE_TECH_CLASSIFICATION=True
FEATURE_ENABLE_MULTI_COUNTRY=True
FEATURE_ENABLE_LANGUAGE_FILTER=True