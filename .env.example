# ============================================================
# Job Market Intelligence — Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# Never commit .env or real credentials.
#
# Environment flow:
#   Environment / Secret Store -> Settings -> Application
#
# Values shown here are safe examples/placeholders only.


# ============================================================
# Application
# ============================================================
APP_NAME=Job Market Intelligence
ENVIRONMENT=development
DEBUG=True

# Required in production. Generate with:
# openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production


# ============================================================
# Server
# ============================================================
HOST=0.0.0.0
PORT=8000


# ============================================================
# Database
# ============================================================
# Preferred for managed/production PostgreSQL (Render/Neon):
# DATABASE_URL=postgresql://user:password@host:port/database

# Local / Docker Compose PostgreSQL configuration:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=job_market_intelligence
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True

# Test database (used by the test suite, not production):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:15432/job_market_intelligence_test


# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=standard


# ============================================================
# API
# ============================================================
API_TITLE=Job Market Intelligence API
API_DESCRIPTION=REST API for technology job market analytics and insights.
API_VERSION=1.0.0
API_PREFIX=/api/v1

# JSON list of allowed browser origins.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501","http://localhost:8000"]


# ============================================================
# Adzuna API / ETL
# ============================================================
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Default geographic coverage
DEFAULT_COUNTRIES=["gb","us","de","fr","ca","au"]

# Pipeline fetching
PIPELINE_RESULTS_PER_PAGE=25
PIPELINE_MAX_PAGES=5
PIPELINE_RETENTION_DAYS=90
ETL_TIMEOUT_MINUTES=240


# ============================================================
# Acquisition Strategy
# ============================================================
ACQUISITION_ENABLED=True
ACQUISITION_TARGET_TECH_RATIO=0.5
ACQUISITION_USE_CATEGORY_FILTER=True
ACQUISITION_MAX_JOBS_PER_RUN=2000
ACQUISITION_BATCH_SIZE=100
ACQUISITION_MAX_QUERIES_PER_COUNTRY=25
ACQUISITION_PARITY_TOLERANCE=0.05

# Legacy/backward-compatible total limit
ACQUISITION_MAX_JOBS_TOTAL=10000

# Query lists default to the values defined in config/settings.py.
# Override with JSON arrays only when needed, for example:
# ACQUISITION_BROAD_QUERIES=["nurse","doctor","teacher"]
# ACQUISITION_TECH_QUERIES=["software engineer","data scientist","data engineer"]


# ============================================================
# Language Detection
# ============================================================
LANGUAGE_DETECTION_ENABLED=True
DEFAULT_LANGUAGE=en


# ============================================================
# Translation
# ============================================================
# Provider: google | deepl | azure | mock
# Development default: google
# Production: use deepl or azure with the corresponding credentials.
TRANSLATION_PROVIDER=google
TRANSLATION_TIMEOUT=15

# DeepL
# DEEPL_API_KEY=your_deepl_api_key_here

# Azure Translator
# AZURE_TRANSLATOR_KEY=your_azure_key_here
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_REGION=your_azure_region_here

# Google Cloud Translation
# GOOGLE_CLOUD_PROJECT=your_project_id_here
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json


# ============================================================
# Technology Classification
# ============================================================
TECH_CLASSIFICATION_ENABLED=True
TECH_CLASSIFICATION_CONFIG_PATH=config/tech_classification.yaml
TECH_ONLY_ANALYTICS=True
TECH_CLASSIFICATION_MIN_CONFIDENCE=0.3


# ============================================================
# Feature Flags
# ============================================================
FEATURE_ENABLE_TRANSLATION=True
FEATURE_ENABLE_TECH_CLASSIFICATION=True
FEATURE_ENABLE_MULTI_COUNTRY=True
FEATURE_ENABLE_LANGUAGE_FILTER=True


# ============================================================
# Dashboard
# ============================================================
APP_TITLE=Job Market Dashboard
APP_ICON=📊
DASHBOARD_TITLE=Job Market Intelligence Dashboard

API_BASE_URL=http://localhost:8000
API_TIMEOUT=30
API_RETRIES=3

ENABLE_CACHE=True
CACHE_TTL_DEFAULT=300
CACHE_MAX_SIZE=100

CACHE_TTL_DASHBOARD_SUMMARY=300
CACHE_TTL_TOP_SKILLS=600
CACHE_TTL_TOP_COMPANIES=600
CACHE_TTL_JOBS_BY_LOCATION=600
CACHE_TTL_SALARY_STATISTICS=900
CACHE_TTL_SALARY_DISTRIBUTION=900
CACHE_TTL_EMPLOYMENT_TYPES=600
CACHE_TTL_POSTING_TREND=300
CACHE_TTL_RECENT_JOBS=300

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

CHART_HEIGHT=400
CHART_THEME=plotly_white
CHART_FONT_FAMILY=Inter, sans-serif
CHART_COLOR_PRIMARY=#0f3460
CHART_COLOR_SECONDARY=#e94560
CHART_COLOR_SUCCESS=#00b894
CHART_COLOR_WARNING=#fdcb6e
CHART_COLOR_INFO=#0984e3

DEFAULT_TOP_SKILLS_LIMIT=15
DEFAULT_TOP_COMPANIES_LIMIT=15
DEFAULT_TOP_LOCATIONS_LIMIT=15
DEFAULT_POSTING_TREND_DAYS=30

ENABLE_ANALYTICS=True
